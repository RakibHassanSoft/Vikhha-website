# ---- Core ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=digital_vikha

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Bootstrap admin (used by `npm run seed`) ----
ADMIN_EMAIL=admin@vikha.bd
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Portal Admin

# ---- Cloudinary (image upload) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=digital-vikha

# ---- Gemini (server side only, never NEXT_PUBLIC_) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Behaviour ----
# Auto approve newly registered seekers (dev convenience). Keep false in production.
AUTO_APPROVE_SEEKERS=false
